{
  "name": "kooboo-ai-automation-lab",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test-node.mjs",
    "build": "vite build --config frontend/vite.config.ts && tsc -p tsconfig.server.build.json",
    "start": "node dist-server/server/main.js",
    "install:browser": "playwright install chromium",
    "migrate:kooboo": "tsx scripts/migrate-kooboo.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@lucide/vue": "1.68.0",
    "@openai/codex-sdk": "0.167.0",
    "fastify": "5.12.8",
    "openai": "7.51.0",
    "playwright": "1.64.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
