# Install Nginx and a valid certificate, replace example domain/certificate paths.
# This server exposes read-only API v1. Keep the full management UI on loopback.
server {
    listen 443 ssl;
    server_name evaluation-api.example.com;
    ssl_certificate /etc/letsencrypt/live/evaluation-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evaluation-api.example.com/privkey.pem;

    location ^~ /api/v1/evaluations {
        if ($request_method != GET) { return 405; }
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host 127.0.0.1:4180;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # Optional: enable ONLY when remote plugins need to submit tasks here.
    # Ingest requests still require the separate ingestion token.
    # location = /api/evaluations {
    #     if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
    #     proxy_pass http://127.0.0.1:4180;
    #     proxy_set_header Host 127.0.0.1:4180;
    #     proxy_set_header Authorization $http_authorization;
    #     proxy_set_header Cookie "";
    # }

    # Optional legacy plugin polling: a single evaluation only, no management routes.
    # location ~ ^/api/evaluations/[0-9a-f-]{36}$ {
    #     if ($request_method !~ ^(GET|OPTIONS)$) { return 405; }
    #     proxy_pass http://127.0.0.1:4180;
    #     proxy_set_header Host 127.0.0.1:4180;
    #     proxy_set_header Authorization $http_authorization;
    #     proxy_set_header Cookie "";
    # }

    location / { return 404; }
}
