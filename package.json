{
  "name": "kooboo-ai-automation-lab",
  "version": "0.7.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test-node.mjs",
    "build": "vite build --config frontend/vite.config.ts && tsc -p tsconfig.server.build.json && node scripts/write-build-info.mjs",
    "start": "node scripts/launch.mjs",
    "release:package": "python3 scripts/package-platform.py --update",
    "release:publish": "node scripts/publish-release.mjs",
    "install:browser": "playwright install chromium",
    "install:collection": "node scripts/install-collection.mjs",
    "check:collection": "node scripts/install-collection.mjs --check",
    "migrate:kooboo": "tsx scripts/migrate-kooboo.ts",
    "audit:migration": "node --import tsx scripts/audit-migration.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@lucide/vue": "1.68.0",
    "@openai/codex-sdk": "0.167.0",
    "echarts": "6.1.0",
    "entities": "7.0.1",
    "fastify": "5.12.8",
    "markdown-it": "15.0.3",
    "openai": "7.51.0",
    "playwright": "1.64.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
