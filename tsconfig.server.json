{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests-node/**/*.ts",
    "scripts/migrate-kooboo.ts"
  ]
}